<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.zettelgarten.wochenreview</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUNNER__</string>
    <string>wochenreview</string>
  </array>

  <!-- launchd startet mit minimalem PATH. Homebrew und ~/.local/bin muessen mit. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>18</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Nicht beim Laden starten. Einen Lauf, den der Mac im Schlaf verpasst hat, holt launchd
       fuer StartCalendarInterval von selbst nach dem Aufwachen nach (einmal, nicht pro Tag). -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Arbeitsverzeichnis: ohne diesen Key startet launchd in "/". Der Runner wechselt
       selbst ins Vault; das hier ist nur die zweite Sicherung. -->
  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/zettelgarten/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/zettelgarten/launchd.err</string>
</dict>
</plist>
