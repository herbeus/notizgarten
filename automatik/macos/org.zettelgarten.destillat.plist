<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.zettelgarten.destillat</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/zettelgarten/automatik/runner.sh</string>
    <string>destillat</string>
  </array>

  <!-- launchd startet mit minimalem PATH. Homebrew und ~/.local/bin muessen mit. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Verpasste Laeufe nachholen, wenn der Mac zur Startzeit geschlafen hat. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/zettelgarten/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/zettelgarten/launchd.err</string>
</dict>
</plist>
