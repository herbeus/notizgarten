# Konfiguration der Zettelgarten-Automatik.
# Kopieren nach ~/.config/zettelgarten/config und anpassen.
#
#   mkdir -p ~/.config/zettelgarten
#   cp automatik/config.example ~/.config/zettelgarten/config
#
# Das ist eine Shell-Datei und wird gesourct. Keine Zugangsdaten hier hinein -
# der Agent bringt seine eigene Anmeldung mit.

# PFLICHT: absoluter Pfad zum Vault.
#   macOS   : "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/MeinVault"
#   Windows : (aus WSL) /mnt/c/Users/<benutzer>/iCloudDrive/iCloud~md~obsidian/MeinVault
#   Linux   : "$HOME/MeinVault"
VAULT="$HOME/MeinVault"

# Wo die Prompt-Dateien dieses Repos liegen. Leer lassen = prompts/ neben dem Runner.
#PROMPT_DIR="$HOME/zettelgarten/prompts"

# PFLICHT fuers Abend-Destillat: die Transkripte deiner Agenten-Sessions.
# Fuer Claude Code:
TRANSCRIPTS="$HOME/.claude/projects"

# Optional fuers Wochenreview: wo deine Repos liegen und unter welcher Adresse du committest.
REPOS="$HOME/projects"
GIT_AUTHOR="ich@example.org"

# CLI des Agenten.
AGENT="claude"

# Log und Zeitlimit.
LOG="$HOME/.local/state/zettelgarten/run.log"
TIMEOUT_SECS=900
# Kommando fuer das Zeitlimit. Leer = "timeout" oder "gtimeout" (Homebrew) im PATH suchen.
#TIMEOUT_BIN=""

# Benachrichtigung nach jedem Lauf: 1 an, 0 aus.
NOTIFY=1
