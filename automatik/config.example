# Konfiguration der Notizgarten-Automatik.
# Kopieren nach ~/.config/notizgarten/config und anpassen.
#
#   mkdir -p ~/.config/notizgarten
#   cp automatik/config.example ~/.config/notizgarten/config
#
# Das ist eine Shell-Datei und wird gesourct. Keine Zugangsdaten hier hinein -
# der Agent bringt seine eigene Anmeldung mit.

# PFLICHT: absoluter Pfad zum Vault.
#   macOS   : "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/MeinVault"
#   Windows : (aus WSL) /mnt/c/Users/<benutzer>/iCloudDrive/iCloud~md~obsidian/MeinVault
#   Linux   : "$HOME/MeinVault"
VAULT="$HOME/MeinVault"

# Wo die Prompt-Dateien dieses Repos liegen.
PROMPT_DIR="$HOME/notizgarten/prompts"

# Quelle fuer die Abendlese: die Transkripte deiner Agenten-Sessions. Mehrere Wurzeln mit ":"
# trennen. Claude Code schreibt nach ~/.claude/projects; Claude Desktop im Cowork-Modus legt pro
# Session ein eigenes .claude/projects/ in seinem Support-Ordner an (macOS-Pfad unten) - ohne
# diese zweite Wurzel bleibt alles, was du dort gearbeitet hast, ungeerntet.
TRANSCRIPTS="$HOME/.claude/projects"
# macOS mit Claude Desktop/Cowork:
# TRANSCRIPTS="$HOME/.claude/projects:$HOME/Library/Application Support/Claude/local-agent-mode-sessions"

# Optional fuers Wochenreview: wo deine Repos liegen und unter welchen Adressen du committest.
# Mehrere Adressen mit Leerzeichen trennen - wer privat und dienstlich unterschiedlich committet,
# braucht beide, sonst fehlt die halbe Woche.
REPOS="$HOME/projects"
GIT_AUTHOR="ich@example.org ich@firma.example"

# CLI des Agenten.
AGENT="claude"

# Log und Zeitlimit.
LOG="$HOME/.local/state/notizgarten/run.log"
TIMEOUT_SECS=900

# Benachrichtigung nach jedem Lauf: 1 an, 0 aus.
NOTIFY=1
